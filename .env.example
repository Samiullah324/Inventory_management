# Inventory Management — local development environment
# Copy to .env and adjust values as needed (works on Windows, macOS, and Linux).

DEBUG=True
SECRET_KEY=change-me-for-local-development-only
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: credentials for `python manage.py setup_admin`
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-strong-local-password
